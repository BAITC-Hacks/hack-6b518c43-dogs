OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
BEEAGENT_AI_BUDGET_USD=3
BEEAGENT_AI_MAX_CALLS=100
# Known models: gpt-5.4-mini (default), gpt-6-sol. For others supply verified rates.
# Mini cache writes are estimated at the standard non-cached input rate.
# BEEAGENT_INPUT_USD_PER_MILLION=0.75
# BEEAGENT_CACHED_USD_PER_MILLION=0.075
# BEEAGENT_OUTPUT_USD_PER_MILLION=4.50
# BEEAGENT_CACHE_WRITE_USD_PER_MILLION=0.75
